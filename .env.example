# SAHAY Platform API Configuration
# Copy this file to .env and fill in your actual API keys

PORT=5000

# AI4Bharat IndicTrans API Key for Indian Language Translation
AI4BHARAT_API_KEY=your_ai4bharat_api_key_here

# Groq API Key for Structured NLP & Reasoning (llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here

# Vapi Voice / Call Agent API Keys
VAPI_API_KEY=your_vapi_private_key_here
VAPI_PUBLIC_KEY=your_vapi_public_key_here
